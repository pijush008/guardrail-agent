# Agent service config (copy to .env and export, or set in your shell)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
GUARDRAIL_MODEL=llama-3.3-70b-versatile

# Guardrail behavior
GUARDRAIL_AUTO_BLOCK=1
GUARDRAIL_REDACT=1
# 0 in production (human-in-the-loop), 1 in CI/tests
GUARDRAIL_AUTO_APPROVE=0
# 1 = deterministic offline demo mode (uses agent/fake_llm.py, no API key)
GUARDRAIL_FAKE_LLM=0

# Supabase persistence (optional — falls back to local JSON under data/)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Confirmation emails (optional — falls back to simulated sender)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=guardrail-agent@example.com
SMTP_TO=approver@example.com
