# --- Python agent service ---
# The Next.js app talks to FastAPI over REST. Use the Next rewrites proxy
# (PYTHON_SERVICE_URL unset -> same-origin /api/proxy) or set a direct URL.
NEXT_PUBLIC_PYTHON_SERVICE_URL=http://localhost:8000

# --- Supabase (Auth + Postgres + Realtime) ---
# Configure for real auth + realtime approvals. Without these the app runs
# in demo mode (no real auth, polling approvals).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
